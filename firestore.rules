rules_version = '2';

// Deny-all placeholder. The real household-scoped rules land in a later task;
// until then nothing is readable or writable, which is the safe default and is
// what firestore/__tests__/harness.test.ts asserts.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} { allow read, write: if false; }
  }
}
