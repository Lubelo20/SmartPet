# Copy to .env.local and fill in. .env.local is git-ignored and must stay that way.
# See SETUP.md for where these values come from.

NEXT_PUBLIC_DATA_SOURCE=mock
NEXT_PUBLIC_TRANSPORT=simulation
NEXT_PUBLIC_DEVICE_ID=ESP32-PETFEEDER-001
NEXT_PUBLIC_USE_EMULATORS=false

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# Telegram alerts. NO NEXT_PUBLIC_ prefix on purpose: that prefix inlines a
# value into the browser bundle, which would hand your bot to anyone who opens
# devtools. These are read only by the server route at app/api/telegram.
# Leave blank to disable — the app runs normally without them.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
